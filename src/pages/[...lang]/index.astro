---
import Base from "../../layouts/Base.astro";
import { LANGUAGES, language, localized, routeParam, codeFromParam, texts } from "../../lib/i18n";
import { app, organization, website } from "../../lib/schema";

export function getStaticPaths() {
  return LANGUAGES.map((l) => ({ params: { lang: routeParam(l.code) } }));
}

const code = codeFromParam(Astro.params.lang);
const t = texts(code);
const inLanguage = language(code).hreflang;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [organization, website(inLanguage), app(t.home_description, inLanguage)],
};
---
<Base
  code={code}
  page="home"
  title={t.home_title}
  description={t.home_description}
  path={localized(code)}
  alternates={LANGUAGES.map((l) => ({ code: l.code, path: localized(l.code) }))}
  jsonLd={jsonLd}
>
  <main class="hero">
    <img class="icon" src="/assets/icon-512.png" alt="" width="120" height="120">
    <h1 class="wordmark">
      <picture>
        <source srcset="/assets/wordmark-negativo.svg" media="(prefers-color-scheme: dark)">
        <img src="/assets/wordmark.svg" alt="Libretta" width="320" height="74">
      </picture>
    </h1>
    <p class="lede" set:html={t.home_lede} />
    <p class="label">{t.home_soon}</p>
  </main>
</Base>
